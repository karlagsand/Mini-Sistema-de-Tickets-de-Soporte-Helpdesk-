APP_NAME=Helpdesk
APP_ENV=production
APP_KEY=base64:REEMPLAZAR_CON_APP_KEY_REAL
APP_DEBUG=false
APP_URL=https://tudominio.empresa.gob.mx
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX
APP_TIMEZONE=America/Mexico_City

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=helpdesk_prod
DB_USERNAME=helpdesk_user
DB_PASSWORD=REEMPLAZAR_CON_PASSWORD_SEGURO

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=smtp.tuempresa.gob.mx
MAIL_PORT=587
MAIL_USERNAME=notificaciones@tuempresa.gob.mx
MAIL_PASSWORD=REEMPLAZAR_CON_PASSWORD_SEGURO
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=notificaciones@tuempresa.gob.mx
MAIL_FROM_NAME="Mesa de ayuda"
